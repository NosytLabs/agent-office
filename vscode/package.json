{
  "name": "agent-office",
  "displayName": "Agent Office",
  "description": "Pixel floor for Hermes, OpenCode, Claude Code, and Telegram — one office, real usage stats, badges.",
  "version": "0.3.0",
  "publisher": "nosytlabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NosytLabs/agent-office"
  },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Visualization", "Other"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "hermesPixelOffice.open",
        "title": "Agent Office: Open Floor"
      }
    ],
    "configuration": {
      "title": "Agent Office",
      "properties": {
        "hermesPixelOffice.stateUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8113/state",
          "description": "URL of the Agent Office /state endpoint."
        },
        "hermesPixelOffice.openOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Open the floor when VS Code starts."
        }
      }
    }
  },
  "keywords": ["hermes", "opencode", "claude", "agents", "pixel art", "office"]
}
